[
  {
    "id": "style:archery",
    "name": "Archery",
    "description": "You gain a +2 bonus to attack rolls you make with ranged weapons.",
    "source": "phb",
    "ruleset": "dnd5e",
    "classes": ["class:fighter", "class:ranger"],
    "mechanics": [
      {
        "type": "passive",
